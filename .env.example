# =====================================================================
# NUTEX WHOLESALE - environment variables
# Copy to .env for local development. NEVER commit real values.
# On Render, set these in Dashboard -> Service -> Environment.
# =====================================================================

# development | production | test
NODE_ENV=development

# Render injects PORT automatically. Locally the API runs on 4000.
PORT=4000

# Public URL of the website (used for CORS, sitemap, OpenGraph links).
# Single Render service: https://<your-service>.onrender.com (or your domain)
FRONTEND_URL=http://localhost:5173

# Keep-alive: the server pings its own /api/ping every few minutes so the host
# never puts the site to sleep. /api/ping reads/writes NO data.
# auto = on in production when a public URL is known (Render sets RENDER_EXTERNAL_URL automatically)
KEEP_ALIVE=auto
# KEEP_ALIVE_URL=https://your-site.onrender.com
# KEEP_ALIVE_INTERVAL_MINUTES=10

# Storage backend. MUST be "google" in production.
# "memory" exists ONLY for local experiments/tests and is refused when NODE_ENV=production.
DATA_BACKEND=google

# ---------------- Google Sheets (primary database) -------------------
# The long ID in the sheet URL: https://docs.google.com/spreadsheets/d/<THIS_PART>/edit
GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Paste the private_key from the service-account JSON. Keep the \n sequences,
# wrap in double quotes. Example: "-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
GOOGLE_PRIVATE_KEY=

# ---------------- Google Drive (persistent file storage) -------------
# ID of the "NUTEX WHOLESALE" folder (from its URL: drive.google.com/drive/folders/<THIS_PART>)
GOOGLE_DRIVE_FOLDER_ID=
# service_account -> folder lives in a Google Workspace SHARED DRIVE shared with the service account
# oauth           -> personal Gmail Drive; requires the three GOOGLE_OAUTH_* values below
#                    (generate the refresh token with: npm run drive:token)
GOOGLE_DRIVE_AUTH=service_account
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=

# ---------------- Security -------------------------------------------
# Long random strings (min 32 chars). Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# Used to sign customer order-access tokens. Rotating it invalidates customer
# links (customers can re-open orders with order number + mobile).
SESSION_SECRET=
# Admin session lifetime: 8h, 30m, 1d ... (a bare number means minutes)
ADMIN_SESSION_TIMEOUT=8h

# ---------------- First admin bootstrap ------------------------------
# Used ONLY when the Admin_Users sheet has no users. Remove after first login.
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
ADMIN_BOOTSTRAP_NAME=Administrator

# ---------------- WhatsApp OTP (existing-customer verification) -------
# Existing customers (listed in the Existing_Customers sheet) verify their
# mobile with a WhatsApp OTP and can then order without the minimum.
# cloudwhatsapp -> POST apikey/mobile/msg to WHATSAPP_API_URL
# console       -> development only: OTP printed in the server log / on screen
WHATSAPP_PROVIDER=cloudwhatsapp
WHATSAPP_API_URL=https://web.cloudwhatsapp.com/wapp/api/send
WHATSAPP_API_KEY=
# Country code put before the 10-digit number (blank if the provider wants 10 digits)
WHATSAPP_MOBILE_PREFIX=91

# ---------------- Optional tuning ------------------------------------
# Catalog cache lifetime (seconds). Checkout/payment always read fresh data.
CATALOG_CACHE_TTL_SECONDS=60
# Number of reverse proxies in front of the app (Render = 1)
TRUST_PROXY=1
LOG_LEVEL=info
