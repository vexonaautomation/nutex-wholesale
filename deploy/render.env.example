# =====================================================================
# NUTEX WHOLESALE - all environment variables for Render, in one file.
#
# 1. Copy this file to deploy/render.env (that file is git-ignored).
# 2. Replace every value that starts with PASTE_ (see docs/RENDER_ENV.md).
# 3. Check it:   npm run env:check
# 4. Render -> your service -> Environment -> "Add from .env" -> paste the
#    whole file -> Add variables -> Save changes.
# Never commit the filled file - it contains passwords and keys.
# =====================================================================

# ---------- App (leave as is) ----------
NODE_ENV=production
NODE_VERSION=22
DATA_BACKEND=google
TRUST_PROXY=1
ADMIN_SESSION_TIMEOUT=8h
CATALOG_CACHE_TTL_SECONDS=60
KEEP_ALIVE=auto

# ---------- Website address ----------
# Render shows it at the top of the service page, e.g. https://nutex-wholesale.onrender.com
# (or your own domain once connected)
FRONTEND_URL=https://PASTE_YOUR_SITE.onrender.com

# ---------- Security secrets (random, 32+ characters each) ----------
# Generate:  node -e "console.log(require('crypto').randomBytes(36).toString('base64url'))"
JWT_SECRET=PASTE_RANDOM_SECRET_1
SESSION_SECRET=PASTE_RANDOM_SECRET_2

# ---------- First admin login (your admin ID + password) ----------
# Password: min 10 characters, letters + numbers. Remove ADMIN_BOOTSTRAP_PASSWORD
# from Render after your first login.
ADMIN_BOOTSTRAP_EMAIL=PASTE_YOUR_ADMIN_EMAIL
ADMIN_BOOTSTRAP_PASSWORD=PASTE_YOUR_ADMIN_PASSWORD
ADMIN_BOOTSTRAP_NAME=Nutex Owner

# ---------- Google Sheets (database) ----------
# From the spreadsheet URL: https://docs.google.com/spreadsheets/d/<THIS_PART>/edit
GOOGLE_SHEET_ID=PASTE_SHEET_ID
# From the service-account JSON key file: "client_email"
GOOGLE_SERVICE_ACCOUNT_EMAIL=PASTE_SERVICE_ACCOUNT_EMAIL
# From the JSON key file: "private_key" - copy it exactly (with the \n parts) inside double quotes
GOOGLE_PRIVATE_KEY="PASTE_PRIVATE_KEY"

# ---------- Google Drive (images, payment QR, payment proofs) ----------
# From the folder URL: https://drive.google.com/drive/folders/<THIS_PART>
GOOGLE_DRIVE_FOLDER_ID=PASTE_DRIVE_FOLDER_ID
# Personal Gmail -> oauth (fill the 3 OAuth lines). Google Workspace Shared drive -> service_account
# (then delete the 3 OAuth lines).
GOOGLE_DRIVE_AUTH=oauth
GOOGLE_OAUTH_CLIENT_ID=PASTE_OAUTH_CLIENT_ID
GOOGLE_OAUTH_CLIENT_SECRET=PASTE_OAUTH_CLIENT_SECRET
# Run "npm run drive:token" on your computer and paste the printed token
GOOGLE_OAUTH_REFRESH_TOKEN=PASTE_REFRESH_TOKEN

# ---------- WhatsApp OTP (existing-customer verification) ----------
WHATSAPP_PROVIDER=cloudwhatsapp
WHATSAPP_API_URL=https://web.cloudwhatsapp.com/wapp/api/send
WHATSAPP_API_KEY=PASTE_WHATSAPP_API_KEY
WHATSAPP_MOBILE_PREFIX=91
